    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "@lp-tracker/contracts": "file:../contracts",
