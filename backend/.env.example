# ============================================================
# LP-Tracker Backend Configuration
# ============================================================

# Application
# ------------------------------------------------------------
# Runtime environment.
# Use "production" for production deployments.
NODE_ENV=development

# Database
# ------------------------------------------------------------
# PostgreSQL server used by LP-Tracker.
DATABASE_HOST=localhost
# PostgreSQL port.
# Default: 5432
DATABASE_PORT=5432
# Application database.
DATABASE_NAME=lp_tracker
# Database user used by the running application.
DATABASE_USER=lp_tracker
# Password for DATABASE_USER.
DATABASE_PASSWORD=change-me


# Database Bootstrap
# ------------------------------------------------------------
# These credentials are only required when using:
#
# npm run db:bootstrap
#
# The PostgreSQL administrator is used to create/update
# DATABASE_NAME and DATABASE_USER.
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=change-me

# Initial Admin Account
# ------------------------------------------------------------
# Used only when LP-Tracker starts without an existing
# administrator account.
#
# Once an admin exists in the database these values are not
# used to overwrite that account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# League Data Provider
# ------------------------------------------------------------
# Supported values:
# opgg
# riot
#
# Default: opgg
# LEAGUE_DATA_PROVIDER=opgg

# Riot Games API
# ------------------------------------------------------------
# Required only when:
#
# LEAGUE_DATA_PROVIDER=riot
#
# Obtain an API key from the Riot Developer Portal.
#
# WARNING:
# Personal and Development API keys have restrictive rate limits.
# Larger events may therefore experience slower refreshes or
# HTTP 429 rate-limit responses.
#
# A Riot Production API key is strongly recommended for
# production deployments and larger events.
# RIOT_API_KEY=